{
  "name": "@nous/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit -p .",
    "start": "NODE_ENV=production AISNS_LLM_MODE=cloudflare tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:set-password": "tsx src/cli/setPassword.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.8",
    "@nous/shared": "workspace:*",
    "better-sqlite3": "11.10.0",
    "drizzle-orm": "0.36.4",
    "hono": "4.6.20",
    "ulid": "2.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.28.1",
    "tsx": "4.23.15",
    "vitest": "2.1.9"
  }
}
