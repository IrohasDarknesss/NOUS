{
  "name": "nous",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.11 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build && pnpm audit --prod > build/audit.txt",
    "start": "pnpm --filter @nous/server start",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @nous/observer --filter @nous/admin test:e2e",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @nous/server db:migrate",
    "admin:set-password": "pnpm --filter @nous/server admin:set-password"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "22.20.5",
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
